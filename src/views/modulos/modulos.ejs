<div class="row justify-content-center py-3">
  <div class="col-xxl-5 col-xl-7 text-center">
    <h3 class="fw-bold">Módulos</h3>
    <p class="text-muted mb-0">
      Gestiona los módulos del sistema. Un módulo con "Padre" en
      <code>idpadre = 0</code> es raíz; los demás cuelgan de un padre.
    </p>
  </div>
</div>

<div class="row justify-content-center">
  <div class="col-12">
    <div class="card">
      <div class="card-header justify-content-between">
        <h5 class="card-title">Módulos</h5>
        <button
          type="button"
          id="btn-nuevo-modulo"
          class="btn btn-sm btn-primary"
        >
          <i class="ti ti-plus align-middle fs-lg me-1"></i> Nuevo
        </button>
      </div>

      <div class="card-body">
        <table
          id="table-modulos"
          data-tables="basic"
          class="table table-striped dt-responsive align-middle mb-0"
        >
          <thead class="thead-sm text-uppercase fs-xxs">
            <tr>
              <th>#</th>
              <th>Módulo</th>
              <th>URL</th>
              <th class="text-center">Icono</th>
              <th>Tipo</th>
              <th>Padre</th>
              <th class="text-center">Orden</th>
              <th class="text-center">Acciones</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
      <!-- end card-body-->
    </div>
    <!-- end card-->
  </div>
</div>
