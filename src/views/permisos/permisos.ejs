<style>
  #roles-list .rol-item {
    text-align: left;
    padding-left: 1rem;
  }
  #roles-list .rol-select {
    background: transparent;
    border: 0;
    padding: 0.25rem 0;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  #roles-list .rol-select:hover {
    color: #0d6efd;
  }
  #roles-list .rol-item.active {
    background-color: #e7f1ff;
    border-color: #e7f1ff;
  }
  #roles-list .rol-item.active .rol-select,
  #roles-list .rol-item.active .rol-nombre-text {
    color: #0d6efd;
    font-weight: 600;
  }
</style>

<div class="row justify-content-center py-3">
  <div class="col-12 text-center">
    <h3 class="fw-bold">Permisos por Rol</h3>
    <p class="text-muted mb-0">
      Selecciona un rol a la izquierda y marca las acciones permitidas para
      cada módulo a la derecha.
    </p>
  </div>
</div>

<div class="row g-3">
  <!-- Columna izquierda: roles -->
  <div class="col-lg-4">
    <div class="card">
      <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="card-title mb-0">Roles</h5>
        <button
          type="button"
          id="btn-nuevo-rol"
          class="btn btn-sm btn-primary"
        >
          <i class="ti ti-plus align-middle me-1"></i> Nuevo
        </button>
      </div>
      <div class="card-body p-0">
        <div
          id="roles-list"
          class="list-group list-group-flush"
          role="tablist"
        >
          <div class="text-center text-muted py-4">
            <span class="spinner-border spinner-border-sm me-2"></span>
            Cargando roles…
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Columna derecha: permisos del rol seleccionado -->
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header d-flex align-items-center justify-content-between">
        <div>
          <h5 class="card-title mb-0">
            <i data-lucide="shield" class="me-1 align-middle"></i>
            <span id="permisos-titulo">Permisos</span>
          </h5>
          <small class="text-muted" id="permisos-subtitulo">
            Selecciona un rol para ver sus permisos.
          </small>
        </div>
        <div class="d-flex align-items-center gap-2">
          <span id="permisos-dirty" class="badge bg-warning text-dark" style="display: none;">Cambios sin guardar</span>
          <button
            type="button"
            id="btn-save-permisos"
            class="btn btn-sm btn-primary"
            disabled
          >
            <i class="ti ti-device-floppy align-middle me-1"></i> Guardar
          </button>
        </div>
      </div>
      <div class="card-body" id="permisos-body">
        <div class="text-center text-muted py-5">
          <i data-lucide="mouse-pointer-click" class="fs-1 d-block mb-2"></i>
          Selecciona un rol en la lista para editar sus permisos.
        </div>
      </div>
    </div>
  </div>
</div>
