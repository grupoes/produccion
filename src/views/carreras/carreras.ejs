<div class="row justify-content-center py-3">
  <div class="col-xxl-5 col-xl-7 text-center">
    <h3 class="fw-bold">Lista de Carreras</h3>
  </div>
</div>

<div class="row justify-content-center">
  <div class="col-12">
    <div class="card">
      <div class="card-header justify-content-between">
        <h5 class="card-title">Carreras</h5>
        <button
          type="button"
          id="btn-nueva-carrera"
          class="btn btn-sm btn-primary"
        >
          <i class="ti ti-plus align-middle fs-lg me-1"></i> Nueva
        </button>
      </div>

      <div class="card-body">
        <table
          id="table-carreras"
          data-tables="basic"
          class="table table-striped dt-responsive align-middle mb-0"
        >
          <thead class="thead-sm text-uppercase fs-xxs">
            <tr>
              <th>#</th>
              <th>Nombre</th>
              <th>Institución</th>
              <th>Estado</th>
              <th class="text-center">Acciones</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
      <!-- end card-body-->
    </div>
    <!-- end card-->
  </div>
</div>
