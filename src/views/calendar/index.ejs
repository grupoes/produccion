<style>
  .cal-shell {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .cal-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1rem 1.25rem;
    background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
    border: 1px solid #e5e7eb;
    border-radius: 0.6rem;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }
  .cal-header .cal-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.1rem;
    color: #0f172a;
    margin-right: auto;
  }
  .cal-header .cal-title i {
    color: #2563eb;
    font-size: 1.35rem;
  }
  .cal-user-select-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .cal-user-select-wrap label {
    font-size: 0.8rem;
    color: #64748b;
    font-weight: 500;
    margin: 0;
    white-space: nowrap;
  }
  .cal-user-select-wrap .form-select {
    min-width: 220px;
    border-color: #cbd5e1;
  }
  .cal-user-select-wrap .form-select:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 0.15rem rgba(37, 99, 235, 0.15);
  }
  .cal-user-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 0.78rem;
  }

  .cal-body {
    display: grid;
    grid-template-columns: minmax(280px, 320px) 1fr;
    gap: 1rem;
  }
  @media (max-width: 991.98px) {
    .cal-body {
      grid-template-columns: 1fr;
    }
  }

  .cal-side {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 0.6rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    max-height: 78vh;
    overflow: hidden;
  }
  .cal-side-head {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid #e5e7eb;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #f8fafc;
  }
  .cal-side-head h6 {
    margin: 0;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #475569;
    font-weight: 700;
  }
  .cal-side-head .count-pill {
    background: #dbeafe;
    color: #1d4ed8;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
  }
  .cal-side-body {
    padding: 0.5rem;
    overflow-y: auto;
    flex: 1;
  }
  .reunion-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.7rem 0.75rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    background: #fff;
    margin-bottom: 0.5rem;
    transition: all 0.15s;
    cursor: pointer;
  }
  .reunion-item:hover {
    border-color: #93c5fd;
    box-shadow: 0 2px 6px rgba(37, 99, 235, 0.08);
    transform: translateY(-1px);
  }
  .reunion-item .reunion-icon {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    border-radius: 0.45rem;
    background: #ede9fe;
    color: #6d28d9;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
  }
  .reunion-item .reunion-body {
    flex: 1;
    min-width: 0;
  }
  .reunion-item .reunion-title {
    font-weight: 600;
    font-size: 0.88rem;
    color: #0f172a;
    line-height: 1.2;
    margin-bottom: 0.15rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .reunion-item .reunion-meta {
    font-size: 0.74rem;
    color: #64748b;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }
  .reunion-item .reunion-meta i {
    font-size: 0.85rem;
  }
  .reunion-item .badge {
    font-size: 0.65rem;
    font-weight: 600;
    padding: 0.15rem 0.4rem;
    border-radius: 0.25rem;
  }

  .cal-main {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 0.6rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .cal-main-head {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid #e5e7eb;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: #f8fafc;
  }
  .cal-main-head .legend {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-left: auto;
    font-size: 0.72rem;
    color: #475569;
    flex-wrap: wrap;
  }
  .cal-main-head .legend .dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    margin-right: 0.3rem;
    vertical-align: middle;
  }
  .dot.dot-prog {
    background: #94a3b8;
  }
  .dot.dot-real-completed {
    background: #16a34a;
  }
  .dot.dot-real-progress {
    background: #2563eb;
  }
  .dot.dot-real-pending {
    background: #9ca3af;
  }

  .cal-main-body {
    padding: 1rem;
    flex: 1;
  }
  #calendar {
    min-height: 70vh;
  }
  /* FullCalendar polish */
  .fc {
    --fc-border-color: #e5e7eb;
    --fc-page-bg-color: #ffffff;
    --fc-neutral-bg-color: #f9fafb;
    --fc-today-bg-color: rgba(37, 99, 235, 0.04);
  }
  .fc .fc-toolbar-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: #0f172a;
  }
  .fc .fc-button {
    background: #fff;
    border: 1px solid #e5e7eb;
    color: #334155;
    text-transform: capitalize;
    font-weight: 500;
    font-size: 0.82rem;
    padding: 0.35rem 0.7rem;
    box-shadow: none !important;
  }
  .fc .fc-button:hover {
    background: #f1f5f9;
    border-color: #cbd5e1;
    color: #0f172a;
  }
  .fc .fc-button-primary:not(:disabled).fc-button-active,
  .fc .fc-button-primary:not(:disabled):active {
    background: #2563eb;
    border-color: #2563eb;
    color: #fff;
  }
  .fc-event {
    border-radius: 0.3rem;
    border: none;
    padding: 2px 4px;
    font-size: 0.78rem;
  }
  .fc-timegrid-slot {
    height: 2.2em;
  }
  .fc-col-header-cell {
    background: #f8fafc;
    font-weight: 600;
    color: #475569;
  }
  .fc-timegrid-axis-cushion {
    color: #94a3b8;
    font-size: 0.72rem;
  }
</style>

<div class="cal-shell mt-2
">
  <!-- Header: user selector + title -->
  <div class="cal-header">
    <div class="cal-title">
      <i class="ti ti-calendar-event"></i>
      <span>Calendario de producción</span>
    </div>

    <div class="cal-user-select-wrap">
      <i
        class="ti ti-user-circle"
        style="color: #64748b; font-size: 1.1rem"
      ></i>
      <label for="js-cal-user">Usuario</label>
      <select class="form-select form-select-sm" id="js-cal-user" disabled>
        <option value="">Cargando usuarios…</option>
      </select>
    </div>

    <button
      type="button"
      class="btn btn-sm btn-primary"
      id="js-cal-new-reunion"
      disabled
      title="Programar reunión o actividad (requiere seleccionar usuario)"
    >
      <i class="ti ti-plus me-1"></i>
      Programar
    </button>

    <button
      type="button"
      class="btn btn-sm btn-outline-danger"
      id="js-cal-btn-permisos"
      title="Gestionar permisos de usuario"
    >
      <i class="ti ti-lock me-1"></i>
      Permisos
    </button>

    <button
      type="button"
      class="btn btn-sm btn-outline-warning"
      id="js-cal-btn-ausencias"
      disabled
      title="Gestionar ausencias de usuario (requiere seleccionar usuario)"
    >
      <i class="ti ti-user-off me-1"></i>
      Ausencias
    </button>

    <span class="cal-user-avatar" title="Sesión actual">YO</span>
  </div>

  <div class="cal-body">
    <!-- Sidebar: REUNION-type tasks -->
    <aside class="cal-side" aria-label="Tareas de tipo Reunión">
      <div class="cal-side-head">
        <h6><i class="ti ti-users-group me-1"></i> Tareas · Reuniones</h6>
        <span class="count-pill" id="js-cal-reuniones-count">0</span>
      </div>
      <div class="cal-side-body" id="js-cal-reuniones-list">
        <!-- mock vacío, sin lógica -->
        <div class="text-center text-muted py-4" style="font-size: 0.85rem">
          <i class="ti ti-info-circle me-1"></i>
          Las reuniones se listarán aquí cuando se conecte la consulta.
        </div>
      </div>
    </aside>

    <!-- Main: FullCalendar -->
    <section class="cal-main">
      <div class="cal-main-head">
        <strong style="font-size: 0.85rem; color: #0f172a"
          >Vista semanal</strong
        >
        <div id="js-horas-extras-resumen" class="ms-auto" style="font-size:0.8rem; color:#6c757d;"></div>
      </div>
      <div class="cal-main-body">
        <div id="calendar"></div>
      </div>
    </section>
  </div>
</div>

<!-- ================================================================
     Modal: Detalle de la reunión
     ================================================================ -->
<div
  class="modal fade"
  id="js-cal-event-modal"
  tabindex="-1"
  aria-hidden="true"
>
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="js-cal-event-title">Detalle de reunión</h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-md-6">
            <h6 class="text-uppercase text-muted fs-xxs fw-semibold mb-2">
              Actividad
            </h6>
            <dl class="row mb-0 fs-sm">
              <dt class="col-5 fw-medium text-muted">Tarea</dt>
              <dd class="col-7" data-cal-field="tarea">—</dd>

              <dt class="col-5 fw-medium text-muted">Prioridad</dt>
              <dd class="col-7" data-cal-field="prioridad">—</dd>

              <dt class="col-5 fw-medium text-muted">Estado</dt>
              <dd class="col-7" data-cal-field="estado_progreso">—</dd>

              <dt class="col-5 fw-medium text-muted" data-cal-wrap="total_reales" style="display:none">Tiempo real</dt>
              <dd class="col-7" data-cal-field="tiempo_real">—</dd>

              <dt class="col-5 fw-medium text-muted" data-cal-wrap="global_inicio" style="display:none">Inicia</dt>
              <dd class="col-7" data-cal-field="global_inicio">—</dd>

              <dt class="col-5 fw-medium text-muted" data-cal-wrap="global_termino" style="display:none">Termina</dt>
              <dd class="col-7" data-cal-field="global_termino">—</dd>
            </dl>

            <hr class="my-2">

            <dl class="row mb-0 fs-sm mt-2" data-cal-wrap="motivo_row" style="display:none">
              <dt class="col-5 fw-medium text-muted">Motivo</dt>
              <dd class="col-7" data-cal-field="motivo">—</dd>
            </dl>
          </div>
          <div class="col-md-6">
            <h6 class="text-uppercase text-muted fs-xxs fw-semibold mb-2">
              Potencial cliente
            </h6>
            <dl class="row mb-0 fs-sm">
              <dt class="col-5 fw-medium text-muted">Título</dt>
              <dd class="col-7" data-cal-field="titulo_prospecto">—</dd>

              <dt class="col-5 fw-medium text-muted">Estado</dt>
              <dd class="col-7" data-cal-field="estado_cliente">—</dd>

              <dt class="col-5 fw-medium text-muted">F. contacto</dt>
              <dd class="col-7" data-cal-field="fecha_contacto">—</dd>

              <dt class="col-5 fw-medium text-muted">F. entrega</dt>
              <dd class="col-7" data-cal-field="fecha_entrega">—</dd>

              <dt class="col-5 fw-medium text-muted">Link Drive</dt>
              <dd class="col-7 text-break" data-cal-field="link_drive">—</dd>
            </dl>
          </div>
          <div class="row g-3 mt-0">
            <div class="col-md-6" data-cal-wrap="contactos" style="display: none">
              <h6 class="text-uppercase text-muted fs-xxs fw-semibold mb-2">
                Contactos
              </h6>
              <ul
                class="list-group list-group-flush fs-sm"
                data-cal-field="contactos"
              ></ul>
            </div>

            <div class="col-md-6">
              <h6 class="text-uppercase text-muted fs-xxs fw-semibold mb-2">
                Bloque en calendario
              </h6>
              <dl class="row mb-0 fs-sm">
                <dt class="col-5 fw-medium text-muted">Fecha</dt>
                <dd class="col-7" data-cal-field="slot_fecha">—</dd>

                <dt class="col-5 fw-medium text-muted">Hora</dt>
                <dd class="col-7" data-cal-field="slot_hora">—</dd>

                <dt class="col-5 fw-medium text-muted">Duración</dt>
                <dd class="col-7" data-cal-field="slot_duracion">—</dd>

                <dt class="col-5 fw-medium text-muted d-none" data-cal-wrap="slot_marca_row">Marca</dt>
                <dd class="col-7 d-none" data-cal-wrap="slot_marca_row" data-cal-field="slot_marca">—</dd>
              </dl>

              <div class="d-flex gap-2 mt-2 flex-wrap d-none" id="js-cal-bloque-acciones">
                <button
                  type="button"
                  class="btn btn-outline-secondary btn-sm"
                  id="js-cal-btn-hora-extra"
                  data-actividad-id=""
                  data-horario-id=""
                >
                  <i class="ti ti-clock-plus me-1"></i>
                  Hora extra
                </button>
                <button
                  type="button"
                  class="btn btn-outline-success btn-sm"
                  id="js-cal-btn-hora-libre"
                  data-actividad-id=""
                  data-horario-id=""
                >
                  <i class="ti ti-clock-off me-1"></i>
                  Hora libre
                </button>
              </div>
            </div>
          </div>
        </div>
        <div
          class="alert alert-warning mt-3 mb-0 d-none"
          id="js-cal-event-warning"
          role="alert"
        >
          <i class="ti ti-alert-triangle me-1"></i>
          <span data-cal-field="warning"></span>
        </div>
      </div>
      <div class="modal-footer d-flex justify-content-between flex-wrap gap-2">
        <div class="d-flex gap-2 flex-wrap">
          <button
            type="button"
            class="btn btn-outline-warning btn-sm d-none"
            id="js-cal-btn-reprogramar"
            data-actividad-id=""
          >
            <i class="ti ti-calendar-clock me-1"></i>
            Reprogramar
          </button>
          <button
            type="button"
            class="btn btn-outline-primary btn-sm d-none"
            id="js-cal-btn-ajustar-duracion"
            data-actividad-id=""
          >
            <i class="ti ti-clock-edit me-1"></i>
            Ajustar duración
          </button>
          <button
            type="button"
            class="btn btn-outline-info btn-sm d-none"
            id="js-cal-btn-reasignar"
            data-actividad-id=""
          >
            <i class="ti ti-user-share me-1"></i>
            Reasignar
          </button>
          <button
            type="button"
            class="btn btn-outline-secondary btn-sm d-none"
            id="js-cal-btn-hora-extra"
            data-actividad-id=""
            data-horario-id=""
          >
            <i class="ti ti-clock-plus me-1"></i>
            Hora extra
          </button>
          <button
            type="button"
            class="btn btn-outline-success btn-sm d-none"
            id="js-cal-btn-hora-libre"
            data-actividad-id=""
            data-horario-id=""
          >
            <i class="ti ti-clock-off me-1"></i>
            Hora libre
          </button>
          <button
            type="button"
            class="btn btn-outline-danger btn-sm d-none"
            id="js-cal-btn-eliminar"
            data-actividad-id=""
          >
            <i class="ti ti-trash me-1"></i>
            Cancelar reunión
          </button>
        </div>
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">
          Cerrar
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ================================================================
     Modal: Reprogramar (mismo usuario, otra fecha/hora)
     ================================================================ -->
<div
  class="modal fade"
  id="js-cal-reprogramar-modal"
  tabindex="-1"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Reprogramar reunión</h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <div class="modal-body">
        <form id="js-cal-reprogramar-form" autocomplete="off">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Fecha</label>
              <input
                type="date"
                class="form-control"
                id="js-cal-rep-fecha"
                required
              />
            </div>
            <div class="col-md-3">
              <label class="form-label">Hora</label>
              <input
                type="time"
                class="form-control"
                id="js-cal-rep-hora"
                required
              />
            </div>
            <div class="col-md-3">
              <label class="form-label">Duración (min)</label>
              <input
                type="number"
                min="5"
                step="5"
                class="form-control"
                id="js-cal-rep-duracion"
                required
              />
            </div>
            <div class="col-12">
              <label class="form-label">Motivo (opcional)</label>
              <textarea
                class="form-control"
                id="js-cal-rep-motivo"
                rows="2"
                maxlength="255"
                placeholder="Ej: cliente pidió cambio de horario"
              ></textarea>
            </div>
          </div>
        </form>
        <div id="js-cal-rep-result" class="mt-3"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">
          Cancelar
        </button>
        <button type="button" class="btn btn-primary" id="js-cal-rep-aplicar">
          <i class="ti ti-save me-1"></i>
          Aplicar
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ================================================================
     Modal: Ajustar duración (mismo día, corre actividades posteriores)
     ================================================================ -->
<div
  class="modal fade"
  id="js-cal-ajustar-duracion-modal"
  tabindex="-1"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Ajustar duración</h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <div class="modal-body">
        <form id="js-cal-ajustar-duracion-form" autocomplete="off">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Duración actual</label>
              <input
                type="text"
                class="form-control"
                id="js-cal-ajd-actual"
                readonly
              />
            </div>
            <div class="col-md-6">
              <label class="form-label">Nueva duración (minutos)</label>
              <input
                type="number"
                min="5"
                step="5"
                class="form-control"
                id="js-cal-ajd-nueva"
                required
              />
            </div>
            <div class="col-12">
              <div class="alert alert-info mb-0 py-2 fs-sm" role="alert">
                <i class="ti ti-info-circle me-1"></i>
                Al cambiar la duración, las actividades <strong>no reunión</strong> posteriores se correrán automáticamente. Las reuniones fijas no se mueven.
              </div>
            </div>
          </div>
        </form>
        <div id="js-cal-ajd-result" class="mt-3"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">
          Cancelar
        </button>
        <button type="button" class="btn btn-primary" id="js-cal-ajd-aplicar">
          <i class="ti ti-save me-1"></i>
          Aplicar
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ================================================================
     Modal: Reasignar a otro usuario
     ================================================================ -->
<div
  class="modal fade"
  id="js-cal-reasignar-modal"
  tabindex="-1"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Reasignar reunión</h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <div class="modal-body">
        <form id="js-cal-reasignar-form" autocomplete="off">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label">Nuevo usuario asignado</label>
              <select class="form-select" id="js-cal-rea-usuario" required>
                <option value="">— Selecciona —</option>
              </select>
              <small class="form-text text-muted" id="js-cal-rea-hint">
                El listado se carga cuando elegís un candidato con hueco.
              </small>
            </div>
            <div class="col-md-4">
              <label class="form-label">Fecha</label>
              <input
                type="date"
                class="form-control"
                id="js-cal-rea-fecha"
                required
              />
