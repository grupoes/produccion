<!-- ================================================================
     Modal: Programar (REUNIONES + CLIENTES)
     ================================================================ -->
<div
  class="modal fade"
  id="js-cal-nueva-modal"
  tabindex="-1"
  aria-hidden="true"
>
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Programar</h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <div class="modal-body p-0">
        <!-- Tabs -->
        <ul class="nav nav-tabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button
              class="nav-link active"
              id="js-cal-tab-reuniones-btn"
              data-bs-toggle="tab"
              data-bs-target="#js-cal-tab-reuniones"
              type="button"
              role="tab"
            >
              <i class="ti ti-calendar-plus me-1"></i>REUNIONES
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button
              class="nav-link"
              id="js-cal-tab-clientes-btn"
              data-bs-toggle="tab"
              data-bs-target="#js-cal-tab-clientes"
              type="button"
