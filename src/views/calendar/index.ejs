<!-- ================================================================
     Modal: Permisos de usuario
     ================================================================ -->
<div class="modal fade" id="js-cal-permisos-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="ti ti-lock me-1"></i>Permisos de usuario</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="row g-4">
          <!-- Formulario -->
          <div class="col-lg-5">
            <div class="card border mb-0">
              <div class="card-body">
                <h6 class="card-title mb-3">Nuevo permiso</h6>
                <div class="mb-3">
                  <label for="cal-pu-usuario" class="form-label">Usuario <span class="text-danger">*</span></label>
                  <select id="cal-pu-usuario" class="form-select form-select-sm">
                    <option value="">— Selecciona —</option>
                  </select>
                </div>
                <div class="mb-3">
                  <label for="cal-pu-fecha" class="form-label">Fecha <span class="text-danger">*</span></label>
                  <input type="date" id="cal-pu-fecha" class="form-control form-control-sm" />
                </div>
                <div class="row g-2 mb-3">
                  <div class="col-6">
                    <label for="cal-pu-hora-inicio" class="form-label">Hora inicio <span class="text-danger">*</span></label>
                    <input type="time" id="cal-pu-hora-inicio" class="form-control form-control-sm" />
                  </div>
                  <div class="col-6">
                    <label for="cal-pu-hora-fin" class="form-label">Hora fin <span class="text-danger">*</span></label>
                    <input type="time" id="cal-pu-hora-fin" class="form-control form-control-sm" />
                  </div>
                </div>
                <div class="mb-3">
                  <label for="cal-pu-motivo" class="form-label">Motivo</label>
                  <textarea id="cal-pu-motivo" class="form-control form-control-sm" rows="2" placeholder="Ej: Trámite personal"></textarea>
                </div>
                <button id="cal-pu-btn-preview" class="btn btn-outline-secondary btn-sm w-100 mb-2">
                  <i class="ti ti-eye me-1"></i>Vista previa
                </button>
                <button id="cal-pu-btn-crear" class="btn btn-danger btn-sm w-100" disabled>
                  <i class="ti ti-lock me-1"></i>Crear permiso y reprogramar
                </button>
                <div id="cal-pu-preview-content" class="mt-2"></div>
                <div id="cal-pu-crear-content" class="mt-2"></div>
              </div>
            </div>
          </div>
          <!-- Listado -->
          <div class="col-lg-7">
            <div class="card border mb-0">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <h6 class="card-title mb-0">Permisos registrados</h6>
                  <select id="cal-pu-filtro-usuario" class="form-select form-select-sm" style="width:auto">
                    <option value="">Todos</option>
                  </select>
                </div>
                <div class="table-responsive">
                  <table class="table table-sm table-bordered mb-0">
                    <thead class="table-light">
                      <tr>
                        <th>Usuario</th>
                        <th>Fecha</th>
                        <th>Desde</th>
                        <th>Hasta</th>
                        <th>Motivo</th>
                        <th style="width:50px"></th>
                      </tr>
                    </thead>
                    <tbody id="cal-pu-tbody"></tbody>
                  </table>
                </div>
                <div id="cal-pu-empty" class="text-center text-muted py-3 d-none">
                  <i class="ti ti-clock-off fs-2 d-block mb-1"></i>No hay permisos registrados.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<!-- ================================================================
     Modal: Ausencias de usuario
     ================================================================ -->
<div class="modal fade" id="js-cal-ausencias-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="ti ti-user-off me-1"></i>Ausencias de usuario</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label">Usuario <span class="text-danger">*</span></label>
            <select class="form-select form-select-sm" id="cal-au-usuario" disabled>
              <option value="">Seleccionar usuario en el calendario primero</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label">Desde <span class="text-danger">*</span></label>
            <input type="date" class="form-control form-control-sm" id="cal-au-fecha-desde" required />
          </div>
          <div class="col-md-3">
            <label class="form-label">Hasta <span class="text-danger">*</span></label>
            <input type="date" class="form-control form-control-sm" id="cal-au-fecha-hasta" required />
          </div>
          <div class="col-md-12">
            <label class="form-label">Motivo</label>
            <textarea class="form-control form-control-sm" id="cal-au-motivo" rows="2" maxlength="255" placeholder="Ej: Licencia médica, renuncia, etc."></textarea>
          </div>
          <div class="col-12">
            <button type="button" class="btn btn-primary btn-sm" id="cal-au-btn-preview">
              <i class="ti ti-eye me-1"></i>Vista previa
            </button>
            <span class="text-muted ms-2 small" id="cal-au-preview-status"></span>
          </div>
        </div>
        <hr />
        <div id="cal-au-actividades-wrap" class="d-none">
          <h6 class="fw-semibold mb-2">
            <i class="ti ti-list-check me-1"></i>
            Actividades afectadas
            <span class="badge bg-secondary ms-1" id="cal-au-actividades-count">0</span>
          </h6>
          <div class="alert alert-warning py-2 mb-2 small d-none" id="cal-au-urgentes-warning">
            <i class="ti ti-alert-triangle me-1"></i>
            Las actividades con prioridad <strong>ALTA</strong> o bloqueadas no pueden reasignarse y pasarán a bono automáticamente.
          </div>
          <div class="table-responsive">
            <table class="table table-sm table-bordered">
              <thead class="table-light">
                <tr>
                  <th style="width:40px">#</th>
                  <th>Cliente</th>
                  <th>Actividad</th>
                  <th>Fecha</th>
                  <th>Hora</th>
                  <th>Prioridad</th>
                  <th>F. entrega</th>
                  <th style="width:200px">Acción</th>
                </tr>
              </thead>
              <tbody id="cal-au-tbody"></tbody>
            </table>
          </div>
          <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancelar</button>
            <button type="button" class="btn btn-warning btn-sm" id="cal-au-btn-ejecutar" disabled>
              <i class="ti ti-play me-1"></i>Ejecutar ausencia
            </button>
          </div>
          <div id="cal-au-result" class="mt-3"></div>
        </div>
      </div>
    </div>
  </div>
</div>

