<div class="row justify-content-center py-3">
  <div class="col-xxl-5 col-xl-7 text-center">
    <h3 class="fw-bold">Reuniones</h3>
    <p class="text-muted mb-0">
      Listado de reuniones (actividades tipo REUNIÓN) registradas para
      los potenciales clientes.
    </p>
  </div>
</div>

<div class="row justify-content-center">
  <div class="col-12">
    <div class="card">
      <div class="card-header justify-content-between">
        <h5 class="card-title">Listado de reuniones</h5>
      </div>

      <div class="card-body">
        <table
          id="table-reuniones"
          data-tables="basic"
          class="table table-striped dt-responsive align-middle mb-0 w-100"
        >
          <thead class="thead-sm text-uppercase fs-xxs">
            <tr>
              <th>#</th>
              <th>Fecha</th>
              <th>Hora</th>
              <th>Detalle</th>
              <th>Cliente</th>
              <th>Celular</th>
              <th>Nivel académico</th>
              <th>Carrera</th>
              <th>Universidad</th>
              <th>Link</th>
              <th>Asistente administrativa</th>
              <th>Tipo cliente</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
      <!-- end card-body-->
    </div>
    <!-- end card-->
  </div>
</div>
